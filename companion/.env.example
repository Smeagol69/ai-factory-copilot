# Leave blank to auto-select a configured hosted/local provider, then fall back
# to diagnostic mode. Explicit values: mock, local, openai, anthropic, hybrid.
AI_PROVIDER=

# What the model is shown. "lean" keeps the item/recipe catalog and Unreal
# reflection on the bridge for the solvers to read, which is ~95x smaller than
# sending the snapshot itself. "full" restores the pre-0.3.0 behaviour.
AIFACTORY_PAYLOAD=lean
AIFACTORY_LEAN_MAX_ACTORS=120
AIFACTORY_LEAN_MAX_CHARS=200000
# Transient 429/529 responses are retried using the provider's own retry-after.
AIFACTORY_MAX_RATE_LIMIT_RETRIES=3

# The server binds to loopback only.
AIFACTORY_PORT=8142
AIFACTORY_MAX_BODY_MB=64
AIFACTORY_MAX_SNAPSHOT_CHARS=2000000
AIFACTORY_HISTORY_MESSAGES=24
AIFACTORY_MAX_SESSIONS=64
AIFACTORY_PROVIDER_TIMEOUT_SECONDS=180
AIFACTORY_MAX_CONCURRENT_REQUESTS=2
AIFACTORY_MAX_QUESTION_CHARS=16000
AIFACTORY_BLUEPRINT_DIR=
AIFACTORY_TERRAIN_CACHE=
# JSONL evidence used to improve free local routing. Blank uses the game's
# LocalAppData diagnostics folder; set off to disable or provide a full path.
AIFACTORY_ROUTING_LOG=
AIFACTORY_COST_FOOTER=true
AIFACTORY_LOCAL_ROUTING=true

# Deterministic solvers.
# How many solver tool rounds a single answer may take before the bridge gives up.
AIFACTORY_MAX_SOLVER_ROUNDS=6
# Withhold live-game claims when the model skipped the deterministic solver
# required to support them. Disabling this removes an important no-guessing gate.
AIFACTORY_ENFORCE_SOLVER_GROUNDING=true
# Conveyor items per minute = reported_speed / this divisor (engine convention).
AIFACTORY_BELT_SPEED_DIVISOR=2
# How many times a paused server-side search may be resumed in one answer.
AIFACTORY_MAX_PAUSE_RESUMES=4

# Outside references. Search is on and restricted to the official wiki, docs,
# and forums by default; the full default list is in companion/lib/sources.mjs.
AIFACTORY_WEB_SEARCH=true
AIFACTORY_RESTRICT_SOURCES=true
AIFACTORY_WEB_SEARCH_MAX_USES=5
# Comma-separated hosts to use instead of the default list.
AIFACTORY_SOURCE_DOMAINS=

# OpenAI: flagship model, local multi-turn history, and optional outside search.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_VERBOSITY=medium
OPENAI_MAX_OUTPUT_TOKENS=2400
OPENAI_WEB_SEARCH=true
OPENAI_WEB_SEARCH_CONTEXT=low
OPENAI_WEB_SEARCH_DOMAIN_FILTER=true
OPENAI_MAX_TOOL_CALLS=12

# Local / free: any OpenAI-compatible Chat Completions server (Ollama, LM Studio,
# llama.cpp, vLLM). No API key, no rate limits, no cost. Set AI_PROVIDER=local.
#   ollama pull qwen3   then   LOCAL_AI_MODEL=qwen3
# Solver accuracy needs a tool-calling model; set LOCAL_AI_TOOLS=false for one
# without it. Live-game answers requiring a solver will then be withheld.
LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_AI_MODEL=
LOCAL_AI_TOOLS=true
LOCAL_AI_MAX_TOKENS=
# Ollama/Qwen defaults to none so hidden thinking cannot consume the tool-call
# budget. Use omit for gateways that reject reasoning_effort, or another value
# explicitly supported by that gateway.
LOCAL_AI_REASONING_EFFORT=
# Only for hosted OpenAI-compatible gateways; a local server needs no key.
LOCAL_AI_API_KEY=

# Anthropic requires an explicit model so a stale model name is never guessed.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Thinking tokens are drawn from this budget, so keep it generous.
ANTHROPIC_MAX_TOKENS=16000
# Adaptive thinking is requested by default. Set to "off" for a model that does
# not support it. A fixed token budget is not accepted by current models.
ANTHROPIC_THINKING=adaptive
# low | medium | high | xhigh | max. Omitted unless set.
ANTHROPIC_EFFORT=
# Pin an older web search tool version if the configured model needs it.
ANTHROPIC_WEB_SEARCH_TOOL=
ANTHROPIC_WEB_SEARCH_BASIC=false
ANTHROPIC_PROMPT_CACHE=true

# Hybrid: deterministic/simple narration can use a local model while questions
# requiring judgement go to a stronger hosted model. Unknown question shapes
# should remain on the strong tier.
AIFACTORY_CHEAP_PROVIDER=local
AIFACTORY_STRONG_PROVIDER=anthropic
AIFACTORY_ESCALATE=
