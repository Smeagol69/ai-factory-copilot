# mock, openai, or anthropic
AI_PROVIDER=mock

# The server binds to loopback only.
AIFACTORY_PORT=8142
AIFACTORY_MAX_BODY_MB=64
AIFACTORY_MAX_SNAPSHOT_CHARS=2000000
AIFACTORY_HISTORY_MESSAGES=24
AIFACTORY_MAX_SESSIONS=64

# Deterministic solvers.
# How many solver tool rounds a single answer may take before the bridge gives up.
AIFACTORY_MAX_SOLVER_ROUNDS=6
# Conveyor items per minute = reported_speed / this divisor (engine convention).
AIFACTORY_BELT_SPEED_DIVISOR=2
# How many times a paused server-side search may be resumed in one answer.
AIFACTORY_MAX_PAUSE_RESUMES=4

# Outside references. Search is on and restricted to the official wiki, docs,
# and forums by default; the full default list is in companion/lib/sources.mjs.
AIFACTORY_WEB_SEARCH=true
AIFACTORY_RESTRICT_SOURCES=true
AIFACTORY_WEB_SEARCH_MAX_USES=5
# Comma-separated hosts to use instead of the default list.
AIFACTORY_SOURCE_DOMAINS=

# OpenAI: flagship model, local multi-turn history, and optional outside search.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_VERBOSITY=medium
OPENAI_MAX_OUTPUT_TOKENS=2400
OPENAI_WEB_SEARCH=true
OPENAI_WEB_SEARCH_CONTEXT=low
OPENAI_MAX_TOOL_CALLS=3

# Anthropic requires an explicit model so a stale model name is never guessed.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Thinking tokens are drawn from this budget, so keep it generous.
ANTHROPIC_MAX_TOKENS=16000
# Adaptive thinking is requested by default. Set to "off" for a model that does
# not support it. A fixed token budget is not accepted by current models.
ANTHROPIC_THINKING=adaptive
# low | medium | high | xhigh | max. Omitted unless set.
ANTHROPIC_EFFORT=
# Pin an older web search tool version if the configured model needs it.
ANTHROPIC_WEB_SEARCH_TOOL=
ANTHROPIC_WEB_SEARCH_BASIC=false
